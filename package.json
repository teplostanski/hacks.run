{
  "name": "hacks.run",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview --config preview.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint --deny-warnings",
    "lint:fix": "vp lint --fix --deny-warnings",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "react-icons": "catalog:frontend",
    "react-server-dom-webpack": "catalog:frontend",
    "vinext": "catalog:frontend"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "@vitejs/plugin-react": "catalog:build",
    "@vitejs/plugin-rsc": "catalog:build",
    "eslint-plugin-slop": "catalog:lint",
    "husky": "catalog:hooks",
    "typescript": "catalog:types",
    "vite": "catalog:build",
    "vite-plugin-readable-classnames": "catalog:build",
    "vite-plus": "catalog:build"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scriptsDescription": {
    "prepare": "Install Husky Git hooks.",
    "dev": "Start the development server.",
    "build": "Build and export the static site to dist/client.",
    "preview": "Preview the production build locally.",
    "typecheck": "Check TypeScript types without emitting files.",
    "lint": "Check code with Oxlint; fail on warnings.",
    "lint:fix": "Apply safe lint fixes; fail on remaining warnings or errors.",
    "format": "Format project files with Oxfmt.",
    "format:check": "Check formatting without modifying files.",
    "check": "Check formatting, lint rules, and TypeScript types."
  }
}
